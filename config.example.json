{
  "group_name": "antigravity-wrap",
  "antigravity_base_dir": "/home/your-user/.antigravity-server/bin",
  "state_file": "/var/lib/ag-wrap/state.json",

  "warp": {
    "proxy_host": "127.0.0.1",
    "proxy_port": 40000
  },

  "singbox": {
    "listen_host": "127.0.0.1",
    "listen_port": 12345,
    "service_name": "ag-wrap-singbox",
    "config_path": "/etc/ag-wrap/sing-box.json"
  },

  "nftables": {
    "table_family": "inet",
    "table_name": "ag_wrap",
    "redirect_tcp_ports": [80, 443],
    "block_udp_ports": [443],
    "block_public_ipv6": true,
    "auto_detect_docker_bridges": true,
    "extra_bypass_cidrs": []
  }
}
