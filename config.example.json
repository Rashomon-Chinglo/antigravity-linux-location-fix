{
  "group_name": "antigravity-warp",
  "antigravity_base_dir": "/root/.antigravity-server/bin",
  "state_file": "/var/lib/ag-warp/state.json",

  "supervisor": {
    "backend": "systemd"
  },

  "warp": {
    "proxy_host": "127.0.0.1",
    "proxy_port": 40000
  },

  "singbox": {
    "listen_host": "127.0.0.1",
    "listen_port": 12345,
    "service_name": "ag-warp-singbox",
    "pm2_app_name": "sing-box-ag-warp",
    "config_path": "/etc/ag-warp/sing-box.json"
  },

  "nftables": {
    "table_family": "inet",
    "table_name": "ag_warp",
    "redirect_tcp_ports": [80, 443],
    "block_udp_ports": [443],
    "block_public_ipv6": true,
    "auto_detect_docker_bridges": true,
    "extra_bypass_cidrs": []
  }
}
